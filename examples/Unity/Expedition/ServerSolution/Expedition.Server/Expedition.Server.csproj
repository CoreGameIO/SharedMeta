<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreGame.SharedMeta.Generator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="CoreGame.SharedMeta.Server" />
    <PackageReference Include="CoreGame.SharedMeta.Server.Core" />
    <PackageReference Include="CoreGame.SharedMeta.Orleans" />
    <PackageReference Include="CoreGame.SharedMeta.Transport.SignalR" />
    <PackageReference Include="CoreGame.SharedMeta.Transport.HttpPolling" />
    <PackageReference Include="CoreGame.SharedMeta.Serialization.MemoryPack" />
    <PackageReference Include="CoreGame.SharedMeta.Auth" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Expedition.Shared\Expedition.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="data\sessionMgr\" />
  </ItemGroup>

</Project>
