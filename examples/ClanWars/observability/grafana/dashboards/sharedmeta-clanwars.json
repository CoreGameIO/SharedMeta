        "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 5000 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(rate(sharedmeta_entity_rpc_duration_milliseconds_count[$__rate_interval]))", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-clanwars" },
