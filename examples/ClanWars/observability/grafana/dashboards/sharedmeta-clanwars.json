    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-clanwars" },
      "type": "stat",
      "title": "Active sessions",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(sharedmeta_session_active)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-clanwars" },
      "type": "stat",
      "title": "Active grains",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "expr": "sharedmeta_grain_active", "legendFormat": "{{state_type}}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-clanwars" },
      "type": "stat",
      "title": "RPC rate (req/sec)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
