    {
      "type": "row",
      "title": "RPC latency & throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "collapsed": false
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-clanwars" },
      "type": "timeseries",
      "title": "Server RPC p95 by method (ms) — method body only",
      "description": "Time spent INSIDE EntityGrain.HandleCallAsync — provider dispatch, method body, broadcasts, persistence. Does NOT include SignalR hub dispatch or SessionManagerGrain queueing. Compare with the 'Server-side total' panel: large diff = queue/grain-hop overhead (often caused by SignalR MaximumParallelInvocationsPerClient = 1 default).",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "id": 10,
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, service, method) (rate(sharedmeta_entity_rpc_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "{{service}}.{{method}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-clanwars" },
      "type": "timeseries",
      "title": "Server-side total p50/p95/p99 (ms) — hub-entry to response",
      "description": "End-to-end at MetaConnectionHandler.RpcCallAsync: SessionManagerGrain queue + grain-hop + method body + response build. Gap vs the 'method body only' panel reveals queue / hop overhead. Reproduces client-perceived server latency without the network leg.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "id": 12,
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(sharedmeta_server_rpc_total_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(sharedmeta_server_rpc_total_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(sharedmeta_server_rpc_total_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-clanwars" },
      "type": "timeseries",
      "title": "Server RPC rate by method (req/sec)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 11,
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom", "showLegend": true } },
      "targets": [
        { "expr": "sum by (service, method) (rate(sharedmeta_entity_rpc_duration_milliseconds_count[$__rate_interval]))", "legendFormat": "{{service}}.{{method}}", "refId": "A" }
      ]
    },
    {
