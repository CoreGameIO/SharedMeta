<Project>
  <!-- .NET 11 runtime-async: JIT generates async state machines instead of the C# compiler,
       reducing per-await allocations. Applies automatically to all async Task / async ValueTask
       methods in the project. Scoped to net11.0 only — net8/10 targets keep the compiler-generated
       async path. https://learn.microsoft.com/en-us/dotnet/core/whats-new/dotnet-11/runtime -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <Features>runtime-async=on</Features>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>CoreGame.IO</Authors>
    <Company>CoreGame.IO</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CoreGameIO/SharedMeta</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CoreGameIO/SharedMeta</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>SharedMeta — framework for shared game meta-logic between Client and Server with deterministic replay.</Description>
    <PackageTags>gamedev;multiplayer;deterministic;meta;shared-logic;orleans</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Version set by CI via /p:Version= or defaults to local dev -->
    <Version>0.21.0</Version>
  </PropertyGroup>
</Project>
