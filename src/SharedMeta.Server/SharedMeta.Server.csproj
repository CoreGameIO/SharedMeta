<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SharedMeta.Core\SharedMeta.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Orleans serialization - needed for CrossEntityCallInfo grain serialization -->
    <PackageReference Include="Microsoft.Orleans.Sdk" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>CoreGame.SharedMeta.Server</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Server-side meta context and cross-entity call infrastructure.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
