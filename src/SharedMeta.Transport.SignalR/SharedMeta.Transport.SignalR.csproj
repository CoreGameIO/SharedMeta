<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>CoreGame.SharedMeta.Transport.SignalR</PackageId>
    <IsPackable>true</IsPackable>
    <Description>SignalR WebSocket transport: MetaHub (server) and SignalRConnection (client) with MessagePack binary protocol.</Description>
    <PackageTags>gamedev;multiplayer;deterministic;meta;shared-logic;signalr;websocket;transport</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedMeta.Core\SharedMeta.Core.csproj" />
    <ProjectReference Include="..\SharedMeta.Orleans\SharedMeta.Orleans.csproj" />
    <ProjectReference Include="..\SharedMeta.Server.Core\SharedMeta.Server.Core.csproj" />
    <!-- MessagePack protocol extensions (client-side extension available transitively) -->
    <ProjectReference Include="..\SharedMeta.Transport.SignalR.MessagePack\SharedMeta.Transport.SignalR.MessagePack.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Client-side SignalR -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!-- Server-side SignalR (for MetaHub) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
