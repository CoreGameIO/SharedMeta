<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>CoreGame.SharedMeta.Inspector.Mcp</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Preview: the API may change in minor versions. MCP endpoint over the SharedMeta Inspector: recent calls, call trees, entity timelines and graphs (TimeMachine), live entity state, capture settings and opt-in method invocation, served over Streamable HTTP inside the server process.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="Ui\*" LogicalName="SharedMeta.Inspector.Mcp.Ui.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedMeta.Inspector\SharedMeta.Inspector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
