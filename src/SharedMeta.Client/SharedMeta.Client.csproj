<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>CoreGame.SharedMeta.Client</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Client-side runtime: MetaClient, ClientDispatcher, optimistic execution, broadcast replay. Targets netstandard2.1 (Unity) and net10.0.</Description>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Source files live in the UPM package directory -->
  <ItemGroup>
    <Compile Include="../../com.coregame.sharedmeta/Runtime/Client/**/*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../com.coregame.sharedmeta/Runtime/Polyfills.cs" Link="Polyfills.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedMeta.Core\SharedMeta.Core.csproj" />
  </ItemGroup>

  <!-- System.Diagnostics.Metrics (Meter/Counter/Histogram) lives in System.Diagnostics.DiagnosticSource
       6+. Built into the BCL on net6+, needs an explicit NuGet on netstandard2.1 (Unity target). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>

</Project>
